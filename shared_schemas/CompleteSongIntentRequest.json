{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CompleteSongIntentRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "core_desire",
    "mood_primary",
    "genre",
    "key_mode",
    "structure",
    "instruments"
  ],
  "properties": {
    "core_desire": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "description": "High-level emotional / production goal"
    },
    "mood_primary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Primary mood of the song"
    },
    "genre": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Genre of the song"
    },
    "tempo": {
      "type": "integer",
      "minimum": 40,
      "maximum": 300,
      "default": 120,
      "description": "BPM clamped to engine limits"
    },
    "key_mode": {
      "type": "string",
      "pattern": "^[A-G][#b]?\\s(major|minor|dorian|mixolydian|lydian|phrygian|aeolian|locrian)$",
      "description": "Key and mode (e.g., C_major)"
    },
    "structure": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/StructureSection"
      },
      "description": "Song structure sections"
    },
    "instruments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/TrackIntent"
      },
      "description": "Track intents with instruments"
    },
    "groove_feel": {
      "type": "string",
      "default": "Straight/Driving",
      "description": "Rhythmic feel dictating quantization/swing"
    },
    "narrative_arc": {
      "type": "string",
      "default": "Climb-to-Climax",
      "description": "Overall energetic trajectory of the song"
    },
    "rule_to_break": {
      "type": ["string", "null"],
      "default": null,
      "description": "Intentional music theory violation for emotional effect"
    },
    "rule_justification": {
      "type": ["string", "null"],
      "default": null,
      "description": "Narrative reason for the rule break"
    },
    "allow_legacy_fallback": {
      "type": "boolean",
      "default": false,
      "description": "Allow fallback to legacy generation"
    }
  },
  "$defs": {
    "StructureSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^(intro|verse|chorus|bridge|outro|build|drop)$"
        },
        "bars": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128,
          "default": 1
        },
        "repetitions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16,
          "default": 1
        }
      }
    },
    "TrackIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instrument"],
      "properties": {
        "instrument": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Canonical instrument name (e.g., piano, synth_bass)"
        },
        "techniques": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Allowed techniques"
        }
      }
    }
  }
}
