{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CompleteSongIntent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "seed",
    "text",
    "intent"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "harmonic",
        "rhythmic",
        "dynamic",
        "tempo"
      ],
      "properties": {
        "harmonic": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "chordDensity",
            "voiceLeading",
            "tension",
            "invariants"
          ],
          "properties": {
            "chordDensity": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            },
            "voiceLeading": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            },
            "tension": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            },
            "invariants": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": [
                "chordDensity + voiceLeading <= 1.5",
                "tension >= 0.0"
              ]
            }
          }
        },
        "rhythmic": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "noteDensity",
            "swing",
            "syncopation",
            "invariants"
          ],
          "properties": {
            "noteDensity": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            },
            "swing": {
              "type": "number",
              "minimum": -1.0,
              "maximum": 1.0
            },
            "syncopation": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            },
            "invariants": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": [
                "swing + syncopation <= 1.0",
                "noteDensity >= 0.0"
              ]
            }
          }
        },
        "dynamic": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "velocityRange",
            "accentStrength",
            "dynamicSpread",
            "invariants"
          ],
          "properties": {
            "velocityRange": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            },
            "accentStrength": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            },
            "dynamicSpread": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            },
            "invariants": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": [
                "accentStrength >= 0.0",
                "velocityRange <= 1.0"
              ]
            }
          }
        },
        "tempo": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bpm",
            "microTiming",
            "humanization",
            "invariants"
          ],
          "properties": {
            "bpm": {
              "type": "integer",
              "minimum": 40,
              "maximum": 300
            },
            "microTiming": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            },
            "humanization": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            },
            "invariants": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": [
                "bpm >= 40",
                "bpm <= 300",
                "microTiming + humanization <= 2.0"
              ]
            }
          }
        }
      }
    }
  }
}
