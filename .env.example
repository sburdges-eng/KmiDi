# =============================================================================
# KmiDi Development Environment Configuration
# =============================================================================
# Copy this file to .env and customize for your local setup
# For user-specific overrides, use .env.local (git-ignored)
# =============================================================================

# =============================================================================
# API Keys & Secrets
# =============================================================================
# Required for ML services and MCP servers
# Get keys from: https://platform.openai.com, https://console.anthropic.com, etc.

OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GOOGLE_API_KEY=your-google-api-key-here
XAI_API_KEY=your-xai-api-key-here
GITHUB_TOKEN=your-github-token-here
FREESOUND_API_KEY=your-freesound-api-key-here

# =============================================================================
# Paths & Directories
# =============================================================================
# Model file locations for C++ and Python components

# C++ model location (used by ModelConfig.h)
KELLY_MODELS_PATH=./models

# Python model location
PYTHON_MODEL_PATH=./models

# Training data and checkpoints
TRAINING_DATA_PATH=./data/training
CHECKPOINT_PATH=./checkpoints
LOG_PATH=./logs

# =============================================================================
# Service URLs & Ports
# =============================================================================
# Tauri/Frontend development server
TAURI_DEV_HOST=localhost
TAURI_PLATFORM=macos

# Backend API
KMIDI_API_URL=http://127.0.0.1:8000

# ML Inference service
ML_INFERENCE_URL=http://127.0.0.1:8001

# MCP Server
MCP_SERVER_PORT=3000

# =============================================================================
# Feature Flags
# =============================================================================
# Enable/disable features

KMIDI_USE_API=false
ENABLE_ML_INFERENCE=true
ENABLE_MCP_SERVERS=true

# =============================================================================
# Debugging & Logging
# =============================================================================
# Rust logging (levels: error, warn, info, debug, trace)
RUST_LOG=info
RUST_BACKTRACE=0

# C++ logging
CXX_LOG_LEVEL=INFO

# Python logging
PYTHON_LOG_LEVEL=INFO

# =============================================================================
# Training Configuration
# =============================================================================
# Distributed training settings

LOCAL_RANK=0
WORLD_SIZE=1
CUDA_VISIBLE_DEVICES=0
TRAINING_BATCH_SIZE=32

# =============================================================================
# Build Configuration (Reference Only)
# =============================================================================
# These are documented here but not loaded as environment variables
# Set them via CMake: cmake -DBUILD_DESKTOP=ON -DBUILD_PLUGINS=ON ..
#
# BUILD_DESKTOP=ON
# BUILD_PLUGINS=ON
# ENABLE_RTNEURAL=ON
# ENABLE_ML=ON
# CMAKE_BUILD_TYPE=Release
