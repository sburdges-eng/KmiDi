# =============================================================================
# EC2 + S3 env for one-time AWS cloud training launch (Cursor / terminal)
# =============================================================================
# Copy and fill:
#   cp config/env.ec2-s3.example .env.ec2-s3
#   # edit .env.ec2-s3 with your values (file is git-ignored)
# Then run:
#   ./scripts/launch_aws_cloud_training.sh
# =============================================================================

# --- Required: EC2 launch ---
# GPU AMI (Amazon Linux 2 or Ubuntu with NVIDIA driver + Python 3)
export KMIDI_AWS_AMI_ID="ami-xxxxxxxx"
export KMIDI_AWS_SUBNET_ID="subnet-xxxxxxxx"
export KMIDI_AWS_SECURITY_GROUP_ID="sg-xxxxxxxx"
# IAM instance profile name or ARN (must allow S3 + EC2 describe + SSM if using Session Manager)
export KMIDI_AWS_IAM_INSTANCE_PROFILE="listening-train-role"

# --- Required: S3 (one of the two options below) ---
# Option A: Set buckets + package ID (run contract can use example buckets; override here)
export KMIDI_PACKAGE_BUCKET="your-package-bucket"
export KMIDI_RUN_BUCKET="your-run-bucket"
export KMIDI_PACKAGE_ID="your-package-id"

# Option B: Full URIs (overrides buckets + package id)
# export KMIDI_PACKAGE_S3_URI="s3://your-package-bucket/training/packages/your-package-id"
# export KMIDI_OUTPUT_S3_URI="s3://your-run-bucket/training/runs"

# --- Optional: AWS credentials / region ---
export AWS_PROFILE="${AWS_PROFILE:-}"
export AWS_DEFAULT_REGION="${AWS_DEFAULT_REGION:-us-east-1}"
# Or for launch script only (no AWS_PROFILE):
# export KMIDI_AWS_PROFILE="your-profile"
# export KMIDI_AWS_REGION="us-east-1"

# --- Optional: EC2 ---
# export KMIDI_AWS_KEY_NAME="your-key-pair"
# export KMIDI_AWS_INSTANCE_TYPE="g5.xlarge"

# --- Optional: Run ---
# export KMIDI_RUN_ID="run-$(date +%Y%m%d-%H%M)"
# export KMIDI_DRY_RUN="1"   # set to 1 to only print resolved config and exit
