# =============================================================================
# SageMaker training job env (Cursor / terminal)
# =============================================================================
# Copy and fill:
#   cp config/env.sagemaker.example .env.sagemaker
#   # edit .env.sagemaker (file is git-ignored)
# Then run:
#   source .env.sagemaker
#   ./scripts/launch_sagemaker_training.py --image-uri "$KMIDI_SAGEMAKER_IMAGE_URI" ...
# =============================================================================

# --- Required: SageMaker ---
# IAM role ARN for SageMaker training (trust: sagemaker.amazonaws.com)
export SAGEMAKER_EXECUTION_ROLE_ARN="arn:aws:iam::123456789012:role/YourSageMakerRole"

# ECR image URI for the training container (must run aws_train_entrypoint.py)
export KMIDI_SAGEMAKER_IMAGE_URI="123456789012.dkr.ecr.us-east-1.amazonaws.com/kmidi-train:latest"

# --- Required: S3 (same concepts as run_contract / EC2) ---
export KMIDI_PACKAGE_BUCKET="your-package-bucket"
export KMIDI_RUN_BUCKET="your-run-bucket"
export KMIDI_PACKAGE_ID="your-package-id"

# Or full URIs (override buckets + package id)
# export KMIDI_PACKAGE_S3_URI="s3://your-package-bucket/training/packages/your-package-id"
# export KMIDI_OUTPUT_S3_URI="s3://your-run-bucket/training/runs"

# --- Optional: AWS ---
export AWS_PROFILE="${AWS_PROFILE:-}"
export AWS_DEFAULT_REGION="${AWS_DEFAULT_REGION:-us-east-1}"

# --- Optional: Job ---
# export KMIDI_RUN_ID="run-$(date +%Y%m%d-%H%M)"
# export KMIDI_SAGEMAKER_INSTANCE_TYPE="ml.g5.xlarge"
# export KMIDI_SAGEMAKER_MAX_RUNTIME_SECONDS=21600
# export KMIDI_DRY_RUN="1"
