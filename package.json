{
    "name": "idaw",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "dev:react": "vite",
        "dev:ui": "vite",
        "dev:tauri": "tauri dev",
        "dev:python": "python3 -m uvicorn music_brain.api:app --reload --port 8000",
        "dev:all": "concurrently -k -n react,api -c blue,magenta \"npm run dev\" \"npm run dev:python\"",
        "typecheck": "tsc --noEmit",
        "lint": "tsc --noEmit",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "tauri": "tauri",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@tauri-apps/api": "^2",
        "@tauri-apps/plugin-dialog": "^2.4.2",
        "@tauri-apps/plugin-fs": "^2.4.4",
        "@tauri-apps/plugin-opener": "^2",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "react-markdown": "^9.0.1",
        "remark-gfm": "^4.0.0"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.1.17",
        "@tauri-apps/cli": "^2",
        "@types/react": "^19.1.8",
        "@types/react-dom": "^19.1.6",
        "@vitejs/plugin-react": "^4.6.0",
        "autoprefixer": "^10.4.22",
        "concurrently": "^9.1.0",
        "postcss": "^8.5.6",
        "tailwindcss": "^4.1.17",
        "typescript": "~5.8.3",
        "vite": "^7.0.4",
        "vitest": "^4.1.1"
    }
}
