        "react-markdown": "^9.0.1",
        "remark-gfm": "^4.0.0"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.1.17",
        "@types/react": "^19.1.8",
        "@types/react-dom": "^19.1.6",
        "@vitejs/plugin-react": "^4.6.0",
        "autoprefixer": "^10.4.22",
        "postcss": "^8.5.6",
        "tailwindcss": "^4.1.17",
        "typescript": "~5.8.3",
        "vite": "^7.0.4",
        "concurrently": "^9.1.0"
    }
}