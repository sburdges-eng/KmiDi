{
    "name": "idaw",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "dev:react": "vite",
        "dev:ui": "vite",
        "dev:python": "./venv/bin/python -m uvicorn music_brain.api:app --reload --port 8000",
        "dev:all": "concurrently -k -n react,api -c blue,magenta \"npm run dev\" \"npm run dev:python\"",
