{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 27,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "xcode-debug",
      "displayName": "Xcode (Debug, arm64)",
      "description": "Generate an Xcode project that pulls in KmiDi_FINAL components and the native macOS app target.",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/build/xcode-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "11.0",
        "USE_KMI_DI_FINAL": "ON",
        "BUILD_NATIVE_MACOS_APP": "ON",
        "KMI_DI_FINAL_ROOT": "${sourceDir}/KmiDi_FINAL",
        "CMAKE_PREFIX_PATH": "/opt/homebrew/opt/qt/lib/cmake;/usr/local/opt/qt/lib/cmake"
      },
      "warnings": {
        "dev": true
      }
    },
    {
      "name": "xcode-release",
      "displayName": "Xcode (Release, arm64)",
      "description": "Release build for Xcode with KmiDi_FINAL integration.",
      "inherits": "xcode-debug",
      "binaryDir": "${sourceDir}/build/xcode-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "ninja-debug",
      "displayName": "Ninja (Debug)",
      "description": "Ninja debug build for iterative C++ work and rt_harness.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_RT_HARNESS": "ON",
        "CMAKE_PREFIX_PATH": "/opt/homebrew/opt/qt/lib/cmake;/usr/local/opt/qt/lib/cmake"
      }
    },
    {
      "name": "ninja-asan",
      "displayName": "Ninja (Debug + ASan)",
      "description": "Ninja debug build with AddressSanitizer enabled.",
      "inherits": "ninja-debug",
      "binaryDir": "${sourceDir}/build-asan",
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-fsanitize=address -fno-omit-frame-pointer -g",
        "CMAKE_CXX_FLAGS": "-fsanitize=address -fno-omit-frame-pointer -g",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address"
      }
    },
    {
      "name": "ninja-tsan",
      "displayName": "Ninja (Debug + TSan)",
      "description": "Ninja debug build with ThreadSanitizer enabled.",
      "inherits": "ninja-debug",
      "binaryDir": "${sourceDir}/build-tsan",
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-fsanitize=thread -g",
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -g",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=thread"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "xcode-debug",
      "configurePreset": "xcode-debug"
    },
    {
      "name": "xcode-release",
      "configurePreset": "xcode-release"
    },
    {
      "name": "ninja-debug-rt-harness",
      "displayName": "Build rt_harness (Debug)",
      "configurePreset": "ninja-debug",
      "targets": ["rt_harness"]
    },
    {
      "name": "ninja-asan-rt-harness",
      "displayName": "Build rt_harness (ASan)",
      "configurePreset": "ninja-asan",
      "targets": ["rt_harness"]
    },
    {
      "name": "ninja-tsan-rt-harness",
      "displayName": "Build rt_harness (TSan)",
      "configurePreset": "ninja-tsan",
      "targets": ["rt_harness"]
    }
  ]
}
