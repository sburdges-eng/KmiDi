# =============================================================================
# Production Environment Template
# =============================================================================
# Template for production deployment. DO NOT commit actual production values.
# Copy to .env.production.local (git-ignored) for actual production config.

# Production logging - less verbose
RUST_LOG=warn
RUST_BACKTRACE=0
CXX_LOG_LEVEL=WARN
PYTHON_LOG_LEVEL=WARN

# Production API endpoints (update with actual URLs)
KMIDI_API_URL=https://api.kmidi.example.com
ML_INFERENCE_URL=https://ml.kmidi.example.com

# Production feature flags
KMIDI_USE_API=true
ENABLE_ML_INFERENCE=true
ENABLE_MCP_SERVERS=false

# Production model paths (update with actual paths)
KELLY_MODELS_PATH=/opt/kmidi/models
PYTHON_MODEL_PATH=/opt/kmidi/models
