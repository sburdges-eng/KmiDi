# =============================================================================
# Development Environment Defaults
# =============================================================================
# Default values for development. Override in .env.local for personal settings.

# Debugging enabled by default in development
RUST_LOG=debug
RUST_BACKTRACE=1
CXX_LOG_LEVEL=DEBUG
PYTHON_LOG_LEVEL=DEBUG

# Development server settings
TAURI_DEV_HOST=localhost
KMIDI_API_URL=http://127.0.0.1:8000

# Feature flags - enable all in development
KMIDI_USE_API=false
ENABLE_ML_INFERENCE=true
ENABLE_MCP_SERVERS=true

# Model paths - relative to project root
KELLY_MODELS_PATH=./models
PYTHON_MODEL_PATH=./models
